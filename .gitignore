# 비밀 정보 (절대 GitHub에 올리지 말 것)
.env
.env.local
.env.*.local

# 설치된 라이브러리들 (용량 크고 다시 받을 수 있음)
node_modules

# 빌드 결과물 (자동 생성됨)
dist
build

# macOS가 자동으로 만드는 파일
.DS_Store

# 개인 에디터 설정
.vscode
.idea
.claude

# 로그 파일
*.log
npm-debug.log*
.vercel

# Capacitor/iOS
ios/App/Pods
ios/App/build
ios/DerivedData
ios/App/App/public
ios/App/Podfile.lock
# cap sync 가 만드는 node_modules 심볼릭 링크 (절대경로라 이 맥에서만 유효)
ios/App/CapApp-SPM/symlinks
assets/
scripts/admin.jpeg

# Firebase 앱 설정 (푸시용). 이 저장소는 public 이라 올리지 않는다.
# 안에 든 건 클라이언트 API 키라 앱 바이너리에도 들어가지만, 공개 저장소에
# 두면 스크래핑 대상이 되므로 로컬에만 둔다. 잃어버리면 Firebase 콘솔
# (프로젝트 rimikimi-ad8aa) → 프로젝트 설정 에서 다시 받으면 된다.
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# 안드로이드 서명 키 (절대 커밋 금지 — 잃어버리면 앱 업데이트 불가)
keystore/
*.jks
*.keystore
android/keystore.properties

# 빌드 산출물 (.aab/.apk)
release/
*.aab
*.apk

# iCloud Drive 충돌 사본 ("config 2.xml") — 안드로이드 리소스 이름 규칙을 깨서 빌드가 죽는다
*\ [0-9].*
